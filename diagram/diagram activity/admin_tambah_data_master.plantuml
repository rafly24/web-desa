@startuml
skinparam style strictuml
skinparam activity {
  BackgroundColor #F9F9F9
  BorderColor #333333
  DiamondBackgroundColor #E8F8F5
}

|Admin|
start
:Memilih Menu Data Master\n(Slider/Kategori/Wilayah/dll);
|Sistem|
:Menampilkan Halaman Tabel Data;
|Admin|
:Klik Tombol 'Tambah Baru';
|Sistem|
:Menampilkan Form Tambah Data;
|Admin|
:Mengisi Form Data Baru;
:Klik Tombol 'Simpan';
|Sistem|
:Melakukan Validasi Input Form;
if (Data Valid?) then (Ya)
  :Menyimpan Data ke Database;
  :Menampilkan Alert Sukses Tambah Data;
else (Tidak)
  :Menampilkan Pesan Error Validasi;
  |Admin|
  :Memperbaiki Input Form;
  detach
endif
|Sistem|
:Memperbarui Tampilan Tabel Data;
stop
@enduml
